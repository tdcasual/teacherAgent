# MCP — required by compose; replace change_me before docker compose up.
MCP_API_KEY=change_me

# Redis
REDIS_PASSWORD=change_me
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Auth
AUTH_TOKEN_SECRET=change_me
AUTH_TOKEN_SECRET_FILE=./config/auth_token_secret
AUTH_REQUIRED=1
RQ_SCAN_PENDING_ON_START=1
APP_ENV=production
# Required to encrypt private provider API keys. No in-code default; missing key refuses writes.
MASTER_KEY=change_me

# Survey webhook HMAC secret. Required when APP_ENV=production or AUTH_REQUIRED=1.
# Unsigned ingest is a local-dev opt-in only (SURVEY_WEBHOOK_ALLOW_INSECURE=1); do not set that flag in compose.
SURVEY_WEBHOOK_SECRET=

# CORS — comma-separated teacher/student compose ports (3001/3002); no wildcard origins
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# LLM keys (at least one required)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
