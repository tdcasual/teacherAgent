# MCP — required, non-empty. Replace change_me with a real key before compose up.
MCP_API_KEY=change_me

# Redis
REDIS_PASSWORD=change_me_in_production

# Auth
AUTH_TOKEN_SECRET=change_me_in_production
AUTH_TOKEN_SECRET_FILE=./config/auth_token_secret
AUTH_REQUIRED=1
APP_ENV=production
MASTER_KEY=change_me

# CORS — comma-separated teacher/student origins
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# LLM keys (at least one required)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
